# ============================================================
# Terra Café — Variáveis de Ambiente (EXEMPLO)
# Copie este arquivo para `.env.local` e preencha os valores reais.
# NUNCA commite o arquivo `.env.local` com chaves verdadeiras.
# ============================================================

# Supabase — pegue os valores em:
# https://supabase.com/dashboard/project/SEU_PROJECT_ID/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxx"

# Prisma / Database (opcional — se usar o Prisma diretamente)
# DATABASE_URL="postgres://..."
# DIRECT_URL="postgres://..."

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gere-uma-chave-segura-aqui-exemplo-openssl-rand-hex-32"

# Admin principal (fallback — não precisa estar no banco)
ADMIN_EMAIL="seu_email@exemplo.com"
ADMIN_PASSWORD="sua_senha_forte"
